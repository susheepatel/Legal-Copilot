{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:selenium": "node selenium-tests/tests/login-tests.js --headless",
    "test:appium": "node appium-tests/tests/app-tests.js",
    "test:security": "python \"Vulnerability Test Results/scripts/generate_security_excel.py\"",
    "test:load": "node load-tests/baseline-load-test.js --vus=100 --duration=60",
    "test:all": "node selenium-tests/tests/login-tests.js --headless && node appium-tests/tests/app-tests.js && python \"Vulnerability Test Results/scripts/generate_security_excel.py\" && node load-tests/baseline-load-test.js --vus=100 --duration=60 && python scripts/consolidate_test_reports.py",
    "reports:consolidate": "python scripts/consolidate_test_reports.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}

{
  "name": "legal-copilot",
  "private": true,
  "version": "2.1.0",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.cjs",
    "expo:lan": "expo start --lan",
    "expo:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:selenium": "node selenium-tests/tests/login-tests.js --headless",
    "test:appium": "node appium-tests/tests/app-tests.js",
    "test:security": "python \"Vulnerability Test Results/scripts/generate_security_excel.py\"",
    "test:load": "node load-tests/baseline-load-test.js --vus=100 --duration=60",
    "test:all": "node selenium-tests/tests/login-tests.js --headless && node appium-tests/tests/app-tests.js && python \"Vulnerability Test Results/scripts/generate_security_excel.py\" && node load-tests/baseline-load-test.js --vus=100 --duration=60 && python scripts/consolidate_test_reports.py",
    "reports:consolidate": "python scripts/consolidate_test_reports.py",
    "db:check": "python scripts/setup_supabase.py",
    "android:sync": "python scripts/sync_android_assets.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "expo": "^58.0.22",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "lucide-react-native": "^0.475.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
